# =============================================================================
# OLYR environment template
#
# Copy to .env for local development:  cp .env.example .env
# NEVER commit real values. Keys and secrets stay local or in deployment env.
# docker-compose.yml reads this file for variable interpolation.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# development | test | production
OLYR_ENV=development

# --- Services -----------------------------------------------------------------
# The web app reads PORT (Next.js convention) and defaults to 3000.
PORT=3000
API_PORT=4000
AGENT_PORT=8000
EXECUTION_PORT=8001
RISK_ENGINE_PORT=8002

# --- Data stores (Phase 2+; used by docker-compose.yml today) -----------------
POSTGRES_USER=olyr
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=olyr
DATABASE_URL=postgresql://olyr:change-me-locally@localhost:5432/olyr
REDIS_URL=redis://localhost:6379

# --- Binance Web3 API (Phase 2: RWA data integration) -------------------------
# Create credentials at https://web3.binance.com/en/dev-portal/project.
# Every Binance Web3 request is signed with the secret key (HMAC-SHA256),
# so BOTH values are required; leave both empty to run without Binance data.
# Never commit real values. These are server-side only — never exposed to
# the browser bundle.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Documented gateway base URL (includes the /build prefix).
BINANCE_BASE_URL=https://web3.binance.com/build
# Request timeout and retry behavior (bounded exponential backoff).
BINANCE_TIMEOUT_MS=10000
BINANCE_MAX_RETRIES=3
BINANCE_BACKOFF_BASE_MS=300
BINANCE_BACKOFF_MAX_MS=5000
# Default binanceChainId for RWA queries. "56" = BNB Smart Chain (OLYR target).
BINANCE_CHAIN_ID=56
# Cache TTLs: metadata (asset lists, profiles) vs time-sensitive prices.
RWA_CACHE_METADATA_TTL_SECONDS=300
RWA_CACHE_PRICE_TTL_SECONDS=15
# Optional shared Redis cache (also used by future phases via REDIS_URL above);
# when unreachable or unset, the API falls back to an in-process cache.

# --- LLM provider (Phase 4; provider abstracted behind an interface) ---------
# Supported: empty (agent runs without LLM; parsing disabled), 'fake' (tests
# only — NEVER use in production), 'openai-compatible'.
OLYR_LLM_PROVIDER=
OLYR_LLM_MODEL=
OLYR_LLM_API_KEY=
OLYR_LLM_BASE_URL=https://api.openai.com/v1
OLYR_LLM_TIMEOUT_SECONDS=30
# Server-side only. Never exposed to the browser bundle.

# --- Strategy platform limits (Phase 4; the LLM can NEVER override these) ----
OLYR_MAX_STRATEGY_TRADE_USD=25
OLYR_MAX_STRATEGY_DAILY_USD=100
OLYR_MAX_SPREAD_THRESHOLD=10
# Comma-separated allowlists; empty = all supported actions / any listed asset.
OLYR_ALLOWED_ACTIONS=
OLYR_ALLOWED_ASSETS=
# Strategy registry owner (development-safe identity abstraction; no auth yet).
OLYR_DEFAULT_OWNER=local-dev
# Internal contract: Fastify -> Python agent (parse requests).
OLYR_AGENT_URL=http://localhost:8000

# --- Execution wallet (Phase 5+; NEVER commit; simulate before broadcast) ----
OLYR_EXECUTOR_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# --- Market intelligence (Phase 3; deterministic thresholds) -----------------
# Spread thresholds in basis points (50 bp = 0.5%).
OLYR_SPREAD_WATCH_THRESHOLD=50
OLYR_SPREAD_OPPORTUNITY_THRESHOLD=150
# Price freshness buckets in seconds (age <= fresh = FRESH, <= aging = AGING, then STALE; beyond stale = unusable).
OLYR_REFERENCE_FRESH_SECONDS=60
OLYR_REFERENCE_AGING_SECONDS=900
OLYR_REFERENCE_STALE_SECONDS=3600
# Minimum on-chain liquidity in USD for OPPORTUNITY status (0 = availability only).
OLYR_MIN_LIQUIDITY=0
# Scanner: bounded polling, never an uncontrolled loop.
OLYR_SCAN_ENABLED=true
OLYR_SCAN_INTERVAL_SECONDS=60
OLYR_SCAN_MAX_ASSETS=10
# Optional comma-separated ticker filter (empty = all assets on the chain).
OLYR_SCAN_ASSETS=
