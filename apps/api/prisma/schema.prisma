// OLYR strategy registry (Phase 4). Postgres via DATABASE_URL.
// Strategies store the validated structured definition — never secrets.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Strategy {
  id          String      @id @default(cuid())
  ownerId     String
  name        String
  status      String      @default("DRAFT") // DRAFT | ACTIVE | PAUSED | DISABLED | INVALID
  definition  Json
  explanation String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  events      AgentEvent[]
  proposals   TradeProposal[]

  @@index([ownerId, createdAt])
}

model AgentEvent {
  id         String    @id @default(cuid())
  strategyId String?
  strategy   Strategy? @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  type       String // see AGENT_EVENT_TYPES in @olyr/types
  detail     Json?
  createdAt  DateTime  @default(now())

  @@index([strategyId, createdAt])
}

model TradeProposal {
  id                       String   @id @default(cuid())
  strategyId               String?
  strategy                 Strategy? @relation(fields: [strategyId], references: [id])
  asset                    String
  action                   String
  requestedAmountUsd       Float
  estimatedPrice           Float?
  referencePrice           Float?
  spreadPercent            Float?
  estimatedSlippagePercent Float?
  marketState              String?
  referenceFreshness       String?
  liquidityStatus          String?
  currentPositionUsd      Float?
  dailyTradedUsd           Float?
  dailyVolumeUsd          Float?
  referenceAgeSeconds      Float?
  status                   String   @default("PENDING_RISK")
  expiresAt                DateTime
  createdAt                DateTime @default(now())
  evaluations              RiskEvaluation[]
  quotes                   TradeQuote[]
  simulations              Simulation[]
  authorizations           ExecutionAuthorization[]
  executions               Execution[]

  @@index([strategyId, createdAt])
}

model RiskEvaluation {
  id             String           @id @default(cuid())
  proposalId     String
  proposal       TradeProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  decision       String
  input          Json
  rulesPassed    Json
  rulesFailed    Json
  warnings       Json
  requiresReview Json?
  rulesEvaluated Json?
  createdAt      DateTime         @default(now())
  ruleResults    RiskRuleResult[]

  @@index([proposalId, createdAt])
}

model RiskRuleResult {
  id           String         @id @default(cuid())
  evaluationId String
  evaluation   RiskEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  rule         String
  outcome      String
  reason       String?
  warning      String?
}

model TradeQuote {
  id                  String   @id @default(cuid())
  proposalId          String
  proposal            TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  chainId             String
  fromTokenAddress    String
  toTokenAddress      String
  amountIn            String
  estimatedAmountOut  String?
  routes              Json
  tradeFeeUsd         String?
  priceImpactPercent  String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([proposalId, createdAt])
}

model Simulation {
  id            String   @id @default(cuid())
  proposalId    String
  proposal      TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  quoteId       String?
  status        String
  apiStatus     String?
  failReason    String?
  result        Json
  swapPreparation Json?
  createdAt     DateTime @default(now())

  @@index([proposalId, createdAt])
}

model ExecutionAuthorization {
  id           String   @id @default(cuid())
  proposalId   String
  proposal     TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  quoteId      String?
  simulationId String?
  decision     String
  actor        String
  policyMode   String
  createdAt    DateTime @default(now())

  @@index([proposalId, createdAt])
}

model Execution {
  id              String   @id @default(cuid())
  proposalId      String
  proposal        TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  quoteId         String?
  simulationId    String?
  authorizationId String?
  state           String   @default("CREATED")
  orderId         String?
  txHash          String?
  failureReason   String?
  idempotencyKey  String   @unique
  environment     String   @default("DRY_RUN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

