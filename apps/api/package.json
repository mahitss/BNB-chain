{
  "name": "@olyr/api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@olyr/binance": "workspace:*",
    "@olyr/config": "workspace:*",
    "@olyr/types": "workspace:*",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
