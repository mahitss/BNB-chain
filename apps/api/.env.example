# Fastify API environment (subset used by apps/api).
# Copy relevant values into the repository-root .env — the API loads it via
# @olyr/config at startup. Never commit real values.

# --- Core ---
OLYR_ENV=development
API_PORT=4000

# --- Database (required for registry/proposals/executions) ---
DATABASE_URL=postgresql://olyr:olyr@localhost:5432/olyr

# --- Binance Web3 API (live RWA data; placeholders only) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://web3.binance.com/build
BINANCE_TIMEOUT_MS=10000
BINANCE_MAX_RETRIES=3
BINANCE_CHAIN_ID=56

# --- Risk engine ---
OLYR_RISK_URL=http://localhost:8002
OLYR_MAX_TRADE_USD=25
OLYR_MAX_DAILY_TRADE_USD=100
OLYR_MAX_POSITION_USD=500
OLYR_MAX_SLIPPAGE_PERCENT=1
OLYR_MAX_REFERENCE_AGE_SECONDS=3600
OLYR_REQUIRE_LIQUIDITY_DATA=true
OLYR_ALLOWED_ASSETS=
OLYR_ALLOWED_ACTIONS=
OLYR_PROPOSAL_TTL_SECONDS=300

# --- Agent ---
OLYR_AGENT_URL=http://localhost:8000

# --- Execution service ---
OLYR_EXECUTION_URL=http://localhost:8001
OLYR_INTERNAL_TOKEN=
OLYR_EXECUTION_POLICY=MANUAL

# --- Ownership (dev-safe identity abstraction) ---
OLYR_DEFAULT_OWNER=local-dev
